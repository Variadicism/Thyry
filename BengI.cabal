name:                BengI
version:             0.2.0.0
synopsis:            This is the interpreter for the Beng programming language.
-- description:
license:             AllRightsReserved
license-file:        LICENSE
author:              Variadicism (Connor Davey)
maintainer:          conman.davey@gmail.com
copyright:           Beng 2016-2019
category:            Language
build-type:          Simple
extra-source-files:  ChangeLog.md, README.md
cabal-version:       >=1.10


executable BengI
  main-is:           Beng/BengI.hs
  other-modules:
    Beng.StandardOps,
    Beng.Values,
    Beng.Read.OpPatterns,
    Beng.Read.Ops,
    Beng.Read.ReadingOps
  ghc-options:       -fno-warn-tabs
  other-extensions:
    InstanceSigs,
    OverloadedStrings,
    ScopedTypeVariables
  build-depends:
    base >=4.11 && <4.12,
    containers >=0.5 && <0.6,
    ordered-containers >=0.2.1 && <0.3,
    text >=1.2 && <1.3,
    MissingH >=1.4 && <1.5,
    Utils >= 0.3 && < 0.4
  hs-source-dirs:     src
  default-language:   Haskell2010

test-suite OpPatterns-test
  type:               exitcode-stdio-1.0
  main-is:            Testing/Beng/Read/OpPatterns.hs
  ghc-options:        -fno-warn-tabs
  other-modules:
    Beng.Read.OpPatterns
  build-depends:
    base >=4.11 && <4.12,
    text >=1.2 && <1.3,
    Utils >= 0.3 && < 0.4
  hs-source-dirs:     src
  default-language:   Haskell2010

test-suite ReadingOps-test
  type:               exitcode-stdio-1.0
  main-is:            Testing/Beng/Read/ReadingOps.hs
  ghc-options:        -fno-warn-tabs
  other-modules:
    Beng.Read.OpPatterns
    Beng.Read.Ops
    Beng.Read.ReadingOps
    Beng.StandardOps
    Beng.Values
  build-depends:
    base >=4.11 && <4.12,
    containers >=0.5 && <0.6,
    ordered-containers >=0.2.1 && <0.3,
    text >=1.2 && <1.3,
    MissingH >=1.4 && <1.5,
    Utils >= 0.3 && < 0.4
  hs-source-dirs:     src
  default-language:   Haskell2010
