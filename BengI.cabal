cabal-version: 2.4
name:                BengI
version:             0.2.1.2
synopsis:            This is the interpreter for the Beng programming language.
-- description:
license:             Artistic-2.0
license-file:        LICENSE
author:              Variadicism (Connor Davey)
maintainer:          conman.davey@gmail.com
copyright:           Beng 2016-2023
category:            Language
build-type:          Simple
extra-source-files:  README.md

executable BengI
  main-is:           Beng/BengI.hs
  other-modules:
    Beng.StandardOps,
    Beng.Values,
    Beng.Read.OpPatterns,
    Beng.Read.Ops,
    Beng.Read.ReadingOps
  ghc-options:       -fno-warn-tabs
  other-extensions:
    InstanceSigs,
    OverloadedStrings,
    ScopedTypeVariables
  build-depends:
    base ^>= 4.15.1.0,
    Utils ^>= 0.13.0.0,
    containers ^>= 0.6.4.1,
    extra ^>= 1.7.10,
    ordered-containers ^>= 0.2.2,
    text ^>= 1.2.4.1,
  hs-source-dirs:     src
  default-language:   Haskell2010

test-suite OpPatterns-test
  type:               exitcode-stdio-1.0
  main-is:            Testing/Beng/Read/OpPatterns.hs
  ghc-options:        -fno-warn-tabs
  other-modules:
    Beng.Read.OpPatterns
  build-depends:
    base ^>= 4.15.1.0,
    Utils ^>= 0.13.0.0,
    text ^>= 1.2.4.1
  hs-source-dirs:     src
  default-language:   Haskell2010

test-suite ReadingOps-test
  type:               exitcode-stdio-1.0
  main-is:            Testing/Beng/Read/ReadingOps.hs
  ghc-options:        -fno-warn-tabs
  other-modules:
    Beng.Read.OpPatterns
    Beng.Read.Ops
    Beng.Read.ReadingOps
    Beng.StandardOps
    Beng.Values
  build-depends:
    base ^>= 4.15.1.0,
    Utils ^>= 0.13.0.0,
    containers ^>= 0.6.4.1,
    extra ^>= 1.7.10,
    ordered-containers ^>= 0.2.2,
    text ^>= 1.2.4.1
  hs-source-dirs:     src
  default-language:   Haskell2010
