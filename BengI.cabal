cabal-version: 2.4
name: BengI
version: 0.11.3.6
synopsis: This is the interpreter for the Beng programming language.
-- description:
license: Artistic-2.0
license-file: LICENSE
author: Variadicism (Connor Davey)
maintainer: conman.davey@gmail.com
copyright: Beng 2016-2024
category: Language
build-type: Simple
extra-source-files: README.md

common options
  build-depends:
    base ^>= 4.17.0.0,
    Utils ^>= 0.16.12,
    composition-prelude ^>= 3.0.0.2,
    containers ^>= 0.6.7,
    extra ^>= 1.7.14,
    ordered-containers ^>= 0.2.1,
    text ^>= 2.0.2
  default-extensions:
    BlockArguments,
    DataKinds,
    DeriveLift,
    DuplicateRecordFields,
    ExistentialQuantification,
    FlexibleInstances,
    LambdaCase,
    LiberalTypeSynonyms,
    NamedFieldPuns,
    OverloadedRecordDot,
    -- OverloadedRecordUpdate,
    OverloadedStrings,
    InstanceSigs,
    PackageImports,
    QuasiQuotes,
    RecordWildCards,
    ScopedTypeVariables,
    StandaloneDeriving,
    TemplateHaskellQuotes,
    TupleSections,
    TypeSynonymInstances,
    UndecidableInstances
  ghc-options: -W -Wno-tabs -Werror
  hs-source-dirs: src
  default-language: Haskell2010
  other-modules:
    Beng.Build
    Beng.Build.Cards
    Beng.Build.Context
    Beng.Build.Context.Builtin
    Beng.Build.Context.Builders
    Beng.Build.Ops
    Beng.Build.Types.Cards
    Beng.Build.Types.Context
    Beng.Interpret
    Beng.Ops
    Beng.Ops.Declarations
    Beng.Ops.Definitions
    Beng.Parse.Matches
    Beng.Parse.Patterns
    Beng.Parse.Patterns.And
    Beng.Parse.Patterns.Arg
    Beng.Parse.Patterns.CharClass
    Beng.Parse.Patterns.Delimited
    Beng.Parse.Patterns.Literal
    Beng.Parse.Patterns.NamedText
    Beng.Parse.Patterns.Or
    Beng.Parse.Patterns.Space
    Beng.Parse.Matches
    Beng.Parse.Parsers
    Beng.Parse.Types.Matches
    Beng.Parse.Types.Parsers
    Beng.Parse.Types.Patterns
    Beng.Types.Ops
    Beng.Types.Ops.Declarations
    Beng.Types.Ops.Definitions
    Beng.Run.Ops
    Beng.Run.Types.Data
    Beng.Run.Types.Values
    Beng.Run.Values

executable BengI
  import: options
  main-is: Beng/BengI.hs

test-suite parse-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Parse.hs
  other-modules:
    Testing.Beng.Parse.And
    Testing.Beng.Parse.CharClass
    Testing.Beng.Parse.Delimited
    Testing.Beng.Parse.Literal
    Testing.Beng.Parse.NamedText
    Testing.Beng.Parse.Or
    Testing.Beng.Parse.Space
    Testing.Beng.Utils.Mocks
    Testing.Beng.Utils.Ops
    Testing.Beng.Utils.Parsers

test-suite build-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Build.hs
  other-modules:
    Testing.Beng.Build.Code
    Testing.Beng.Build.Ops
    Testing.Beng.Utils.Build
    Testing.Beng.Utils.Mocks
    Testing.Beng.Utils.Ops
    Testing.Beng.Utils.Parsers

test-suite run-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Run.hs
  other-modules:
    Testing.Beng.Run.Context
    Testing.Beng.Run.Ops
    Testing.Beng.Utils.Build
    Testing.Beng.Utils.Mocks
    Testing.Beng.Utils.Ops
    Testing.Beng.Utils.Run