cabal-version: 2.4
name: BengI
version: 0.5.0.0
synopsis: This is the interpreter for the Beng programming language.
-- description:
license: Artistic-2.0
license-file: LICENSE
author: Variadicism (Connor Davey)
maintainer: conman.davey@gmail.com
copyright: Beng 2016-2024
category: Language
build-type: Simple
extra-source-files: README.md

common options
  build-depends:
    base ^>= 4.17.0.0,
    Utils ^>= 0.16.0.1,
    containers ^>= 0.6.7,
    extra ^>= 1.7.14,
    ordered-containers ^>= 0.2.1,
    text ^>= 2.0.2
  default-extensions:
    BlockArguments,
    DataKinds,
    DeriveLift,
    DuplicateRecordFields,
    ExistentialQuantification,
    FlexibleInstances,
    LambdaCase,
    LiberalTypeSynonyms,
    NamedFieldPuns,
    OverloadedRecordDot,
    -- OverloadedRecordUpdate,
    OverloadedStrings,
    InstanceSigs,
    PackageImports,
    QuasiQuotes,
    RecordWildCards,
    ScopedTypeVariables,
    TemplateHaskellQuotes,
    TupleSections,
    TypeSynonymInstances,
    UndecidableInstances
  ghc-options: -W -Wno-tabs -Werror
  hs-source-dirs: src
  default-language: Haskell2010

executable BengI
  import: options
  main-is: Beng/BengI.hs
  other-modules:
    Beng.Interpret
    Beng.Ops
    Beng.Ops.Builtin
    Beng.Ops.Declarations
    Beng.Ops.Definitions
    Beng.Parse
    Beng.Parse.Matches
    Beng.Parse.Patterns
    Beng.Parse.Patterns.And
    Beng.Parse.Patterns.Arg
    Beng.Parse.Patterns.Delimited
    Beng.Parse.Patterns.Empty
    Beng.Parse.Patterns.Literal
    Beng.Parse.Patterns.Or
    Beng.Parse.Patterns.Space
    Beng.Parse.Arguments
    Beng.Parse.Ops
    Beng.Parse.Context
    Beng.Parse.Matches
    Beng.Parse.Matches.NonPrefixed
    Beng.Parse.Parsers
    Beng.Parse.Types.Arguments
    Beng.Parse.Types.Context
    Beng.Parse.Types.Matches
    Beng.Parse.Types.Matches.NonPrefixed
    Beng.Parse.Types.Parsers
    Beng.Parse.Types.Patterns
    Beng.Types.Declarations
    Beng.Types.Definitions
    Beng.Types.Ops
    Beng.Run.Ops
    Beng.Run.Types.Values
    Beng.Run.Values

test-suite reading-OpPatterns-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Read/OpPatterns.hs
  other-modules:
    Beng.Parse.Patterns
    Beng.Parse.Patterns.And
    Beng.Parse.Patterns.Delimited
    Beng.Parse.Patterns.Empty
    Beng.Parse.Patterns.Literal
    Beng.Parse.Patterns.Or
    Beng.Parse.Patterns.Space
    Beng.Types.Patterns
    Testing.Beng.Parse.OpAnd
    Testing.Beng.Parse.OpDelimited
    Testing.Beng.Parse.OpEmpty
    Testing.Beng.Parse.OpLiteral
    Testing.Beng.Parse.OpOr
    Testing.Beng.Parse.OpSpace

test-suite building-Ops-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Build/Ops.hs
  other-modules:
    Beng.BuiltinOps
    Beng.Ops
    Beng.Parse.Ops
    Beng.Parse.Patterns
    Beng.Parse.Patterns.And
    Beng.Parse.Patterns.Delimited
    Beng.Parse.Patterns.Empty
    Beng.Parse.Patterns.Literal
    Beng.Parse.Patterns.Or
    Beng.Parse.Patterns.Space
    Beng.Parse.Types.Context
    Beng.Types.Ops
