cabal-version: 2.4
name:                BengI
version:             0.3.0.1
synopsis:            This is the interpreter for the Beng programming language.
-- description:
license:             Artistic-2.0
license-file:        LICENSE
author:              Variadicism (Connor Davey)
maintainer:          conman.davey@gmail.com
copyright:           Beng 2016-2023
category:            Language
build-type:          Simple
extra-source-files:  README.md

executable BengI
  main-is:           Beng/BengI.hs
  other-modules:
    Beng.BuiltinOps
    Beng.Ops
    Beng.Types.OpPatterns
    Beng.Types.Ops
    Beng.Read.OpPatterns
    Beng.Read.Ops
  ghc-options:       -fno-warn-tabs
  other-extensions:
    InstanceSigs
    OverloadedStrings
    ScopedTypeVariables
  build-depends:
    base ^>= 4.15.1.0,
    Utils ^>= 0.14.2.0,
    containers ^>= 0.6.4.1,
    extra ^>= 1.7.10,
    ordered-containers ^>= 0.2.2,
    text ^>= 1.2.4.1,
  hs-source-dirs:     src
  default-language:   Haskell2010

test-suite reading-OpPatterns-test
  type:               exitcode-stdio-1.0
  main-is:            Testing/Beng/Read/OpPatterns.hs
  ghc-options:        -fno-warn-tabs
  other-modules:
    Beng.Read.OpPatterns
    Beng.Types.OpPatterns
    Testing.Beng.Read.OpAnd
    Testing.Beng.Read.OpDelimited
    Testing.Beng.Read.OpEmpty
    Testing.Beng.Read.OpLiteral
    Testing.Beng.Read.OpOr
    Testing.Beng.Read.OpSpace
  build-depends:
    base ^>= 4.15.1.0,
    Utils ^>= 0.14.2.0,
    text ^>= 1.2.4.1
  hs-source-dirs:     src
  default-language:   Haskell2010

test-suite building-Ops-test
  type:               exitcode-stdio-1.0
  main-is:            Testing/Beng/Build/Ops.hs
  ghc-options:        -fno-warn-tabs
  other-modules:
    Beng.BuiltinOps
    Beng.Ops
    Beng.Read.Ops
    Beng.Read.OpPatterns
    Beng.Types.OpPatterns
    Beng.Types.Ops
  build-depends:
    base ^>= 4.15.1.0,
    Utils ^>= 0.14.2.0,
    containers ^>= 0.6.4.1,
    extra ^>= 1.7.10,
    ordered-containers ^>= 0.2.2,
    text ^>= 1.2.4.1
  hs-source-dirs:     src
  default-language:   Haskell2010
