name:                BengI
version:             0.1.0.0
synopsis:            This is the interpreter for the Beng programming language.
-- description:
license:             AllRightsReserved
license-file:        LICENSE
author:              Variadicism
maintainer:          conman.davey@gmail.com
copyright:           Beng 2016-2019
category:            Language
build-type:          Simple
extra-source-files:  ChangeLog.md, README.md
cabal-version:       >=1.10


executable BengI
  main-is:           BengI.hs
  other-modules:
    Beng.Read.OpPatterns,
    Beng.Read.Ops,
    Beng.Read.ReadingOps,
    Beng.Read.Values
  other-extensions:
    InstanceSigs,
    OverloadedStrings,
    ScopedTypeVariables
  build-depends:
    base >=4.11 && <4.12,
    containers >=0.5 && <0.6,
    ordered-containers >=0.1 && <0.2,
    text >=1.2 && <1.3,
    MissingH >=1.4 && <1.5,
    Utils >= 0.2 && < 0.3
  hs-source-dirs:     src
  default-language:   Haskell2010
