cabal-version: 2.4
name: BengI
version: 0.4.0.3
synopsis: This is the interpreter for the Beng programming language.
-- description:
license: Artistic-2.0
license-file: LICENSE
author: Variadicism (Connor Davey)
maintainer: conman.davey@gmail.com
copyright: Beng 2016-2023
category: Language
build-type: Simple
extra-source-files: README.md

common options
  build-depends:
    base ^>= 4.17.0.0,
    Utils ^>= 0.16,
    containers ^>= 0.6.7,
    extra ^>= 1.7.14,
    ordered-containers ^>= 0.2.1,
    text ^>= 2.0.2
  default-extensions:
    BlockArguments,
    DataKinds,
    DeriveLift,
    DuplicateRecordFields,
    ExistentialQuantification,
    FlexibleInstances,
    LambdaCase,
    LiberalTypeSynonyms,
    NamedFieldPuns,
    OverloadedRecordDot,
    -- OverloadedRecordUpdate,
    OverloadedStrings,
    InstanceSigs,
    PackageImports,
    QuasiQuotes,
    RecordWildCards,
    ScopedTypeVariables,
    TemplateHaskellQuotes,
    TupleSections,
    TypeSynonymInstances,
    UndecidableInstances
  ghc-options: -W -Wno-tabs -Werror
  hs-source-dirs: src
  default-language: Haskell2010

executable BengI
  import: options
  main-is: Beng/BengI.hs
  other-modules:
    Beng.BuiltinOps
    Beng.Ops
    Beng.Read.OpPatterns
    Beng.Read.OpPatterns.OpAnd
    Beng.Read.OpPatterns.OpDelimited
    Beng.Read.OpPatterns.OpEmpty
    Beng.Read.OpPatterns.OpLiteral
    Beng.Read.OpPatterns.OpOr
    Beng.Read.OpPatterns.OpSpace
    Beng.Read.Ops
    Beng.Read.Types.Context
    Beng.Types.OpPatterns
    Beng.Types.Ops

test-suite reading-OpPatterns-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Read/OpPatterns.hs
  other-modules:
    Beng.Read.OpPatterns
    Beng.Read.OpPatterns.OpAnd
    Beng.Read.OpPatterns.OpDelimited
    Beng.Read.OpPatterns.OpEmpty
    Beng.Read.OpPatterns.OpLiteral
    Beng.Read.OpPatterns.OpOr
    Beng.Read.OpPatterns.OpSpace
    Beng.Types.OpPatterns
    Testing.Beng.Read.OpAnd
    Testing.Beng.Read.OpDelimited
    Testing.Beng.Read.OpEmpty
    Testing.Beng.Read.OpLiteral
    Testing.Beng.Read.OpOr
    Testing.Beng.Read.OpSpace

test-suite building-Ops-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Build/Ops.hs
  other-modules:
    Beng.BuiltinOps
    Beng.Ops
    Beng.Read.Ops
    Beng.Read.OpPatterns
    Beng.Read.OpPatterns.OpAnd
    Beng.Read.OpPatterns.OpDelimited
    Beng.Read.OpPatterns.OpEmpty
    Beng.Read.OpPatterns.OpLiteral
    Beng.Read.OpPatterns.OpOr
    Beng.Read.OpPatterns.OpSpace
    Beng.Read.Types.Context
    Beng.Types.OpPatterns
    Beng.Types.Ops
