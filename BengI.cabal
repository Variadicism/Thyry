cabal-version: 2.4
name: BengI
version: 0.16.0.9
synopsis: This is the interpreter for the Beng programming language.
-- description:
license: Artistic-2.0
license-file: LICENSE
author: Variadicism (Connor Davey)
maintainer: variadicism@variadicism.dev
copyright: Beng 2016-2025
category: Language
build-type: Simple
extra-source-files: README.md

common options
  build-depends:
    base ^>= 4.19.1.0,
    Utils ^>= 0.20.10.0,
    bytestring ^>= 0.12.0.1,
    composition-prelude ^>= 3.0.0.2,
    containers ^>= 0.6.7,
    extra ^>= 1.7.14,
    ordered-containers ^>= 0.2.1,
    text ^>= 2.1.1
  default-extensions:
    BlockArguments,
    DataKinds,
    DeriveLift,
    DuplicateRecordFields,
    ExistentialQuantification,
    FlexibleInstances,
    FunctionalDependencies,
    LambdaCase,
    LiberalTypeSynonyms,
    MultiParamTypeClasses,
    NamedFieldPuns,
    OverloadedRecordDot,
    -- OverloadedRecordUpdate,
    OverloadedStrings,
    InstanceSigs,
    PackageImports,
    QuasiQuotes,
    RecordWildCards,
    ScopedTypeVariables,
    StandaloneDeriving,
    TemplateHaskellQuotes,
    TupleSections,
    TypeSynonymInstances,
    UndecidableInstances
  ghc-options: -W -Wno-tabs -Wno-x-partial -Werror
  hs-source-dirs: src
  default-language: Haskell2010
  other-modules:
    Beng.Build
    Beng.Build.Cards
    Beng.Build.Context
    Beng.Build.Context.Builtin
    Beng.Build.Context.Builders
    Beng.Build.Ops
    Beng.Build.TypeTest
    Beng.Errors
    Beng.Interpret
    Beng.Locations
    Beng.Ops
    Beng.Ops.Declarations
    Beng.Ops.Definitions
    Beng.Parse.Matches
    Beng.Parse.Patterns
    Beng.Parse.Patterns.And
    Beng.Parse.Patterns.Arg
    Beng.Parse.Patterns.CharClass
    Beng.Parse.Patterns.Delimited
    Beng.Parse.Patterns.Literal
    Beng.Parse.Patterns.NamedText
    Beng.Parse.Patterns.Or
    Beng.Parse.Patterns.Space
    Beng.Parse.Matches
    Beng.Parse.Parsers
    Beng.Parse.Parsers.Code
    Beng.Parse.Parsers.PatternComparator
    Beng.Types.Build.Cards
    Beng.Types.Build.Context
    Beng.Types.Build.TypeTest
    Beng.Types.Errors
    Beng.Types.Locations
    Beng.Types.Ops
    Beng.Types.Ops.Declarations
    Beng.Types.Ops.Definitions
    Beng.Types.Parse.Matches
    Beng.Types.Parse.Parsers
    Beng.Types.Parse.Parsers.Code
    Beng.Types.Parse.Patterns
    Beng.Types.Parse.Parsers.PatternComparator
    Beng.Types.Things
    Beng.Run
    Beng.Things

executable BengI
  import: options
  main-is: Beng/BengI.hs

test-suite parse-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Parse.hs
  other-modules:
    Testing.Beng.Parse.Code
    Testing.Beng.Parse.Code.And
    Testing.Beng.Parse.Code.CharClass
    Testing.Beng.Parse.Code.Delimited
    Testing.Beng.Parse.Code.Literal
    Testing.Beng.Parse.Code.NamedText
    Testing.Beng.Parse.Code.Or
    Testing.Beng.Parse.Code.Space
    Testing.Beng.Utils.Mocks
    Testing.Beng.Utils.Ops
    Testing.Beng.Utils.Parsers

test-suite build-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Build.hs
  other-modules:
    Testing.Beng.Build.Code
    Testing.Beng.Build.NonPrefixed
    Testing.Beng.Build.Prefixed
    Testing.Beng.Utils.Build
    Testing.Beng.Utils.Mocks
    Testing.Beng.Utils.Ops
    Testing.Beng.Utils.Parsers
    Testing.Beng.Build.Validate
    Testing.Beng.Build.Validate.PatternComparator
    Testing.Beng.Build.Validate.PatternComparator.And
    Testing.Beng.Build.Validate.PatternComparator.Arg
    Testing.Beng.Build.Validate.PatternComparator.CharClass
    Testing.Beng.Build.Validate.PatternComparator.Delimited
    Testing.Beng.Build.Validate.PatternComparator.Literal
    Testing.Beng.Build.Validate.PatternComparator.NamedText
    Testing.Beng.Build.Validate.PatternComparator.Or
    Testing.Beng.Build.Validate.PatternComparator.Space
    Testing.Beng.Build.Validate.PatternComparator.Utils
    Testing.Beng.Build.Validate.Typecheck

test-suite run-test
  import: options
  type: exitcode-stdio-1.0
  main-is: Testing/Beng/Run.hs
  other-modules:
    Testing.Beng.Run.Context
    Testing.Beng.Run.Ops
    Testing.Beng.Utils.Build
    Testing.Beng.Utils.Mocks
    Testing.Beng.Utils.Ops
    Testing.Beng.Utils.Parsers
    Testing.Beng.Utils.Run